# Copy this file to .env and fill the key locally. Never commit .env.
MINIMAX_API_KEY=

# MiniMax China defaults
MINIMAX_API_BASE=https://api.minimaxi.com
MINIMAX_TEXT_MODEL=MiniMax-M3
MINIMAX_IMAGE_MODEL=image-01
MINIMAX_TTS_MODEL=speech-2.8-hd
MINIMAX_TTS_VOICE=female-chengshu
MINIMAX_TTS_EMOTION=calm
MINIMAX_TTS_SPEED=0.92
MINIMAX_TTS_VOLUME=1
MINIMAX_TTS_PITCH=-1

# Local Knowledge Video Studio service
STUDIO_HOST=127.0.0.1
STUDIO_PORT=8789
# Set to 1 only for automated tests. Mock mode never calls MiniMax.
STUDIO_MOCK=0
